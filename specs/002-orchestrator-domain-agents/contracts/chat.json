{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator/chat",
  "title": "POST /chat — Request & Response Contract",
  "description": "Primary chat endpoint. Accepts a user message, classifies intent, routes to Domain Agent via A2A, returns synthesized response.",
  "version": "1.0.0",

  "request": {
    "method": "POST",
    "path": "/chat",
    "headers": {
      "Authorization": {
        "type": "string",
        "required": false,
        "description": "Bearer token. Forwarded to all downstream services via ContextVar. MUST NOT be stored."
      },
      "X-Tenant-Id": {
        "type": "string",
        "required": false,
        "description": "Tenant identifier. Forwarded alongside Authorization."
      },
      "X-Session-Id": {
        "type": "string",
        "required": false,
        "description": "Session ID for conversation continuity. Generated by server if absent."
      },
      "Content-Type": {
        "type": "string",
        "enum": ["application/json"],
        "required": true
      }
    },
    "body_schema": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "User message text (Vietnamese or English)"
        },
        "session_id": {
          "type": "string",
          "description": "Optional session ID for conversation continuity. Overrides X-Session-Id header."
        }
      }
    }
  },

  "response": {
    "200": {
      "description": "Message processed successfully",
      "content_type": "application/json",
      "schema": {
        "type": "object",
        "required": ["session_id", "reply", "intent", "trace_id"],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session ID (use in subsequent requests for conversation continuity)"
          },
          "reply": {
            "type": "string",
            "description": "Assistant's response to the user"
          },
          "intent": {
            "type": "string",
            "enum": ["order", "bi_query", "chitchat", "unknown"],
            "description": "Classified intent of the user message"
          },
          "trace_id": {
            "type": "string",
            "description": "Distributed trace ID for this request"
          },
          "requires_input": {
            "type": "boolean",
            "default": false,
            "description": "True when the system is awaiting further user input (e.g., order confirmation). Next message should continue same session."
          },
          "metadata": {
            "type": "object",
            "required": ["duration_ms"],
            "properties": {
              "duration_ms": { "type": "integer" },
              "model_used": { "type": "string" },
              "agent_routed_to": { "type": "string", "nullable": true }
            }
          }
        }
      },
      "examples": [
        {
          "session_id": "sess-abc123",
          "reply": "Tôi đã tạo đơn hàng cho anh Lâm: 2 trứng lộn. Tổng: 20,000đ. Xác nhận không?",
          "intent": "order",
          "trace_id": "trace-xyz789",
          "requires_input": true,
          "metadata": { "duration_ms": 1842, "model_used": "gpt-4o-mini", "agent_routed_to": "order-agent" }
        }
      ]
    },

    "422": {
      "description": "Request validation error",
      "schema": {
        "type": "object",
        "required": ["error", "error_code"],
        "properties": {
          "error": { "type": "string" },
          "error_code": { "type": "string", "enum": ["VALIDATION_ERROR"] }
        }
      }
    },

    "504": {
      "description": "Domain Agent timed out",
      "schema": {
        "type": "object",
        "required": ["session_id", "reply", "error_code"],
        "properties": {
          "session_id": { "type": "string" },
          "reply": { "type": "string", "description": "User-friendly timeout message" },
          "error_code": { "type": "string", "enum": ["AGENT_TIMEOUT"] }
        }
      }
    }
  },

  "security_constraints": [
    "Authorization header MUST NOT appear in any log output",
    "Authorization header MUST NOT appear in any response body",
    "Session IDs MUST be unguessable (UUID v4)"
  ]
}
