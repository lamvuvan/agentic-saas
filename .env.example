# ── API ────────────────────────────────────────────────────────────
API_BASE=https://api.openapi.vn/v3

# ── PostgreSQL (analytics DB for BI handler) ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/analytics

# ── Redis (short-term memory / LangGraph checkpointer) ──────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Tool Registry service ────────────────────────────────────────────────────
TOOL_REGISTRY_PORT=8001
TOOLS_YAML_PATH=config/tools.yaml
HOTRELOAD_INTERVAL_S=1

# ── Orchestrator service ─────────────────────────────────────────────────────
ORCHESTRATOR_PORT=8000

# ── Domain Agent services ────────────────────────────────────────────────────
ORDER_AGENT_PORT=8002
BI_AGENT_PORT=8003

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o

# ── Orchestrator A2A routing ─────────────────────────────────────────────────
ORDER_AGENT_URL=http://localhost:8002
BI_AGENT_URL=http://localhost:8003
TOOL_REGISTRY_URL=http://localhost:8001

# ── A2A polling ──────────────────────────────────────────────────────────────
A2A_POLL_INTERVAL_MS=500
A2A_TIMEOUT_MS=30000
